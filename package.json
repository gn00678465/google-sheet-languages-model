{
  "name": "google-sheet-languages-model-workspace",
  "private": true,
  "version": "0.5.1",
  "description": "Workspace root. The publishable package and CLI live in packages/gslm.",
  "repository": {
    "type": "git",
    "url": "https://github.com/gn00678465/google-sheet-languages-model.git"
  },
  "author": "neil585456525 <neil585456525@gmail.com>",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:napi": "pnpm -C packages/gslm build",
    "build:napi:debug": "pnpm -C packages/gslm build:debug",
    "test:napi": "pnpm -C packages/gslm test",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "pnpm -C packages/gslm test",
    "build": "pnpm -C packages/gslm build",
    "example:cli:pull": "cd example && node ../packages/gslm/bin/gslm.js pull",
    "example:cli:push": "cd example && node ../packages/gslm/bin/gslm.js push",
    "release": "bumpp",
    "release:minor": "bumpp minor",
    "release:major": "bumpp major",
    "changelog": "changelogen --output CHANGELOG.md"
  },
  "devDependencies": {
    "bumpp": "^10.3.2",
    "changelogen": "^0.6.2"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee"
}
