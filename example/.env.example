# `gslm.toml` 可由這些值覆寫；勿將實際憑證提交至版本控制。
GSLM_SHEET=your_google_sheet_id_here

# service-account JSON 必須是單行，且要加引號 —— 未加引號的 JSON（含 `{`、
# `"`、`,`）無法被 .env 解析。
# GSLM_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}'
